# Copy to apps/api/.env and adjust. Never commit real secrets.
NODE_ENV=development
PORT=4000

# Local dev: `npm run dev:db` starts a single-node replica set on this port (transactions supported).
MONGODB_URI=mongodb://127.0.0.1:27017/rythubazaar?replicaSet=rb-dev

# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars

# Comma-separated allowlist of browser origins.
CORS_ORIGINS=http://localhost:5173

SESSION_TTL_HOURS=168
COOKIE_SECURE=false

# Demo IVR routing. The dial code lives only here.
DEMO_DIAL_CODE=12908
# Optional extra internal demo routes: code:ROUTE,code:ROUTE  (ROUTE must be a known IVR route)
EXTRA_DEMO_ROUTES=

# Providers. Only demo/mock adapters are implemented; real providers require credentials and code.
TELEPHONY_MODE=demo
AI_INTERPRETER=rules
PAYMENT_MODE=demo
PAYOUT_PROVIDER=mock

# Fees (integer paise). Farmer commission is always zero and is not configurable.
DELIVERY_FEE_PAISE=3000
FREE_DELIVERY_THRESHOLD_PAISE=50000
SERVICE_FEE_BPS=200
SERVICE_FEE_CAP_PAISE=2000
RETURN_WINDOW_HOURS=48

RATE_LIMIT_ENABLED=true
CALL_IDLE_TIMEOUT_MINUTES=10
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=2
LOG_LEVEL=info

# Required only by `npm run seed` (development only). Seed refuses to run in production.
SEED_PASSWORD=
