{
  "name": "rythubazaar",
  "private": true,
  "version": "0.1.0",
  "description": "RythuBazaar — farmer-first produce marketplace with a keypad-phone IVR demo.",
  "engines": {
    "node": ">=20.19.0 <25"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:db": "npm run dev:db -w @rythubazaar/api",
    "dev:api": "npm run dev -w @rythubazaar/api",
    "dev:web": "npm run dev -w @rythubazaar/web",
    "seed": "npm run seed -w @rythubazaar/api",
    "build": "npm run build -w @rythubazaar/api && npm run build -w @rythubazaar/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "overrides": {
    "esbuild": "0.28.2",
    "vite": "7.3.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "15.15.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  }
}
